// Cloudflare Worker for design.anantf.com: static files only (public/), no code, no data, no secrets.
{
  "name": "ntf-design",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "design.anantf.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
